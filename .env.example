# Aplicación
NODE_ENV=development
PORT=3001
PUBLIC_SITE_URL=http://localhost:8080
OPEN_SOURCE_SITE_URL=https://opensource.bzcreators.com.ar
VITE_API_URL=

# MySQL 8.0+
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bz_creators
DB_USER=bz_creators
DB_PASSWORD=local_bz_password
DB_SSL=false

# Seguridad. Usa al menos 32 caracteres aleatorios en producción.
JWT_SECRET=development_only_replace_with_random_secret_123456
JWT_EXPIRES_IN=12h
COOKIE_SECURE=false

# La cuenta se crea solamente si todavía no existe.
ADMIN_EMAIL=admin@localhost.test
ADMIN_PASSWORD=local_admin_password

# Imágenes del blog
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
